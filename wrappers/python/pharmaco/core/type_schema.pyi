from typing_extensions import (
    Iterator,
    ReadOnly,
    Tuple,
    Type,
    Dict,
    TypeVar,
    Any,
    overload,
    Optional,
    Generic,
)

class TypeSchemaError:
    error: ReadOnly[str]
    @staticmethod
    def value_error(error: str) -> TypeSchemaError: ...
    @staticmethod
    def type_error(error: str) -> TypeSchemaError: ...

class TypeSchemaValidationError:
    def insert_type_error(self, name: str, err: str) -> TypeSchemaValidationError: ...
    def __iter__(self) -> Iterator[Tuple[str, TypeSchemaError]]: ...
    def __len__(self) -> int: ...
    def empty(self) -> bool: ...

T = TypeVar("T")

class TypeSchema(Generic[T]):
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __init__(self, t : Type[T]) -> None: ...
    @overload
    def validate_parameters(self, obj: Any) -> T: ...
    @overload
    def validate_parameters(
        self, obj: Any, errors: TypeSchemaValidationError, path: str
    ) -> Optional[T]: ...
    @staticmethod
    def from_typedef(typedef: Type[T]) -> Optional[TypeSchema[T]]: ...

class TypedRecordTypeSchema(Generic[T]):
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __init__(self, t : Type[T]) -> None: ...
    @overload
    def validate_parameters(self, obj: Dict[str, Any], path: str) -> T: ...
    @overload
    def validate_parameters(
        self, obj: Dict[str, Any], errors: TypeSchemaValidationError, path: str
    ) -> Optional[T]: ...
    @overload
    def validate_parameters(self, obj: Any, path: str) -> T: ...
    @overload
    def validate_parameters(
        self, obj: Any, errors: TypeSchemaValidationError, path: str
    ) -> Optional[T]: ...
