from typing_extensions import TypeVar, Dict, List, Union, Any, Optional, Generic
from pharmaco.core.type_schema import TypedRecordTypeSchema
from pharmaco.core.io_nodes import IONodes
from pharmaco.core.zip import ZipBuilder
import pathlib

GenericType = Union[
    None, int, float, str, Dict[str, "GenericType"], List["GenericType"]
]

class PluginError(Exception):
    def attr(self) -> str: ...
    def reason(self) -> str: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def what(self) -> str: ...

class GenericPlugin:
    def get_default_parameters(self, deps: GenericType) -> GenericType: ...
    def get_params_schema(self) -> TypedRecordTypeSchema[Any]: ...
    def get_results_schema(self) -> TypedRecordTypeSchema[Any]: ...
    def get_in_nodes_schema(self) -> TypedRecordTypeSchema[Any]: ...
    def get_in_nodes(self) -> IONodes: ...
    def get_out_nodes(self) -> IONodes: ...

    # All Optional
    def validate_in_nodes(self, in_nodes: GenericType) -> Optional[GenericType]: ...
    def validate_parameters(self, params: GenericType) -> Optional[GenericType]: ...
    def get_required_token(self, params: GenericType) -> Optional[int]: ...
    def get_download_zip(self, builder: ZipBuilder, work_dir: pathlib.Path) -> None: ...

class PluginIO:
    params_schema: TypedRecordTypeSchema
    results_schema: TypedRecordTypeSchema
    in_nodes_schema: TypedRecordTypeSchema
    in_nodes: IONodes
    out_nodes: IONodes

    def schema_validate_parameters(self, params: GenericType) -> GenericType: ...
    def schema_validate_results(self, results: GenericType) -> GenericType: ...
    def schema_validate_in_nodes(self, in_nodes: GenericType) -> GenericType: ...
    @staticmethod
    def make(plugin: GenericPlugin) -> PluginIO: ...

T = TypeVar("T", bound=GenericPlugin)

class LoadedPlugin(Generic[T]):
    def io(self) -> PluginIO: ...
    def plugin(self) -> T: ...
    def plugin_validate_in_nodes(self, in_nodes: GenericType) -> GenericType: ...
    def validate_in_nodes(self, in_nodes: GenericType) -> GenericType: ...
    def plugin_get_default_parameters(self, in_nodes: GenericType) -> GenericType: ...
    def get_default_parameters(self, in_nodes: GenericType) -> GenericType: ...
    def plugin_validate_parameters(self, in_nodes: GenericType) -> GenericType: ...
    def validate_parameters(self, params: GenericType) -> GenericType: ...
    def get_required_token(self, params: GenericType) -> int: ...
    def get_download_zip(
        self, zip_path: pathlib.Path, work_dir: pathlib.Path
    ) -> None: ...

def make_plugin(plugin: T) -> LoadedPlugin[T]: ...
