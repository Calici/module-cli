from typing_extensions import Iterator, ReadOnly, Tuple, overload
import pathlib

class TypeSchemaError:
    error: ReadOnly[str]
    @staticmethod
    def value_error(error: str) -> TypeSchemaError: ...
    @staticmethod
    def type_error(error: str) -> TypeSchemaError: ...

class TypeSchemaValidationError:
    def insert_type_error(self, name: str, err: str) -> TypeSchemaValidationError: ...
    def __iter__(self) -> Iterator[Tuple[str, TypeSchemaError]]: ...
    def __len__(self) -> int: ...
    def empty(self) -> bool: ...

class IONodes:
    def insert(self, name: str, type: str) -> IONodes: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Tuple[str, str]]: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    @staticmethod
    def make_empty() -> IONodes: ...

class ZipBuilder:
    @overload
    def add_file(self, p : pathlib.Path) -> ZipBuilder: ...
    @overload
    def add_file(self, r : str, content : str) -> ZipBuilder: ...
    def add_directory(self, p : pathlib.Path) -> ZipBuilder: ...
    def add_to_zip(self, p : pathlib.Path) -> ZipBuilder: ...
